# Шаблон переменных окружения. Реальные значения - только в .env (он в .gitignore).

# === Секреты провайдеров ===
# Telegram-бот уведомлений о заказах: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда бот шлёт заказы и отчёты (Рафаэль + я)
TELEGRAM_ORDERS_CHAT_ID=
# Ozon Seller API (потом: купоны и карточки) - личный кабинет Ozon -> Настройки -> Seller API
OZON_CLIENT_ID=
OZON_API_KEY=
# WB API (потом, платный с 2026) - кабинет WB -> Профиль -> Доступ к API
WB_API_TOKEN=

# === База ===
# PostgreSQL на сервере в РФ (152-ФЗ)
DATABASE_URL=

# === Хранилище файлов ===
# S3-совместимое хранилище в РФ для видео сцен и изображений
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес CDN/бакета для видео
MEDIA_PUBLIC_BASE_URL=

# === Оплата ===
# CloudPayments - личный кабинет -> Настройки сайта
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=

# === Бизнес-конфиг ===
# Адрес сайта (тестовый поддомен до SEO-переезда)
SITE_URL=
# Счётчик Яндекс Метрики
YANDEX_METRIKA_ID=
# Секрет для подписи короткоживущей ссылки на экран отгрузки (15 минут), отдельный от CLOUDPAYMENTS_API_SECRET.
# Ссылку присылает бот в TELEGRAM_ORDERS_CHAT_ID - второй переменной для этого не нужно, см. 07-безопасность.md, 4.3 и 08-структура-кода.md, раздел 5
SHIPPING_LINK_SECRET=
