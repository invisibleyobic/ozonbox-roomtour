#!/usr/bin/env bash
# pre-commit: проверка секретов в индексе Git перед каждым коммитом.
# Основа - claude-code-starter 1.1.0; добавлен поиск Python на Windows
# (python3 может оказаться заглушкой Microsoft Store, тогда берём python или py -3).
#
# Установка вручную и только если своего hook ещё нет:
#   git config --get core.hooksPath      # пусто - hooks лежат в .git/hooks
#   cp .github/hooks/pre-commit.sample .git/hooks/pre-commit
# Обход через --no-verify запрещён правилами проекта (CLAUDE.md).
set -euo pipefail
ROOT=$(git rev-parse --show-toplevel) || exit 2
cd "$ROOT"
for candidate in python3 python "py -3"; do
  # Намеренно без кавычек: "py -3" должно разделиться на команду и аргумент.
  if $candidate -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
    exec $candidate "$ROOT/scripts/check_secrets.py" --staged
  fi
done
echo 'pre-commit: не найден Python 3.8+, проверка секретов не выполнена - коммит остановлен.' >&2
exit 2
