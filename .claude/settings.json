{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || powershell.exe -c \"[console]::beep(1000,200)\" 2>/dev/null || printf '\\a'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Ping.aiff 2>/dev/null || powershell.exe -c \"[console]::beep(800,150)\" 2>/dev/null || printf '\\a'"
          }
        ]
      }
    ]
  },

  "permissions": {
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /)",
      "Bash(export *&& curl *)",
      "Bash(export *;curl *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.mcp.json)",
      "Read(./**/credentials.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(wget *$*)",
      "Bash(chmod 777 *)"
    ]
  }
}
